# Plantilla de .env.docker.local (que se genera solo, no se versiona y vive en la raíz del
# checkout principal: lo comparten el repo y sus worktrees, igual que la base).
# db.localtest.me resuelve a 127.0.0.1; si tu red lo bloquea, agrega esa línea al archivo hosts.
# Todo es local: la base de Docker solo escucha en 127.0.0.1.
MAGASTORE_DB_POSTGRES_URL=postgres://postgres:postgres@db.localtest.me:54329/magastore
JWT_SECRET=<se genera al azar>
# Clave inválida a propósito: la app exige una, pero nunca se envía un correo.
RESEND_API_KEY=re_docker_local_sin_envio
NEXT_PUBLIC_API_URL=/api
# Usuario ADMIN de prueba; la contraseña se genera al azar y se guarda solo en el archivo local.
TEST_USER_EMAIL=prueba@ejemplo.test
TEST_USER_PASSWORD=<se genera al azar>
