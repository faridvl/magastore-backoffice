{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Edit(*.md)",
      "Edit(**/*.md)"
    ],
    "ask": [
      "Bash(*migrate.mjs*)",
      "PowerShell(*migrate.mjs*)",
      "Bash(*dbmigrate*)",
      "PowerShell(*dbmigrate*)",
      "Bash(git push*)",
      "PowerShell(git push*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File .claude/hooks/log-session.ps1"
          }
        ]
      }
    ]
  }
}
