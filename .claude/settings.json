{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Read",
      "Edit(*.md)",
      "Edit(**/*.md)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File .claude/hooks/log-session.ps1"
          }
        ]
      }
    ]
  }
}
